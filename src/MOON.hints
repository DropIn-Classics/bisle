; the startup code's table of routines it calls before the program
; (CODE:01E0 with SI = 1508h, DI = 1514h; records of 6 bytes: a type, 0
; for a near routine, a priority and the pointer): two near routines,
; CODE:20F5 and CODE:2CE5 (BATTLE.EXE has three; not run)
words DATA:150A 2 CODE stride=6
; DATA:1226, 122A and 122E are far pointers to this routine, which does
; nothing (PUSH DS, DS = DATA, POP DS, RETF), as BATTLE.EXE's CODE:1D7F
code CODE:1C5D
; a far routine nothing calls (no CALL, no far pointer found by
; ptrscan.py): PUSH BP ... RETF, returns a number clamped to 0..63h (a
; percentage, presumably; not checked). BATTLE.EXE has no such bytes
code T1867:034E

; T070B fills a record's fields 4Eh..68h with far pointers to routines,
; as BATTLE.EXE's T0708:10F6 (what the record is: not checked)
ptr T070B:110E CODE   ; +4E CODE:1776
ptr T070B:111D T25AD  ; +52 T25AD:0006
ptr T070B:112C T25B6  ; +56 T25B6:0008
ptr T070B:113B T261E  ; +5A T261E:0008
ptr T070B:114A CODE   ; +5E CODE:20B0
ptr T070B:1159 T0DA1  ; +62 T0DA1:05F2
ptr T070B:1168 CODE   ; +66 CODE:1C14

; T261E:0008 (x, y, entry far, far ?, base, buffer far): a library entry
; that begins with TPWM (MOON's BIGUNIT.LIB and FIGHT.LIB pack each entry;
; tools/libfiles.py) is unpacked into the buffer by T27D5:0008 (source
; far, target far; 0 back when it was one, read from the code) and drawn
; from there with T25B6:0008, another drawn as it is (not run).
name T261E:0008 draw_entry_unpacked
name T27D5:0008 unpack_mem

; ==== carried over from BATTLE.hints by tools/xfer.py; check, then keep or edit
; BATTLE.EXE: the game (Battle Isle), Borland C++ 1991, large model;
; started by BI.EXE after the intro.
; Hints for doskit/tools/disasm.py; numbers are hex.
; the segments, from the relocations and the header (SS:SP = 2F32:0080);
; DS holds DGROUP (DATA, 2D8D: the startup code loads it). A module's code
; segment T.... begins where the one before ends (start=, first guessed
; from the lowest offset a far CALL/JMP enters it by; T2248's from the end
; of T223C's switch table at T223C:00B6, 7 words to 2248:0004; T1F5A's,
; T25A6's and T2354's from runs: the last routine before them ends with a
; RETF in their frame, T2354:0000 POP SI, POP BP, RETF, zeros to 0010)
; zeros after the stack (SP = 0080h, the file goes on for 220h bytes; what
; they are is not known yet)
; the header as TLINK writes it, its relocations in its order
; how the compiler encoded what has two encodings: AND and OR with a
; small constant in the word form (81h), XCHG AX,reg as 87h /r, TEST r,r
; with the first register in r/m (counted over the reached code; the
; library's assembly modules differ, their instructions are raw below)
; the library's assembly modules: the byte form of AND/OR, XCHG AX,reg in
; one byte, XOR r,r in the r/m,reg form (see asm above)
raw CODE:0052 ; and bx, 0xfff0
raw CODE:028F ; xor ah, ah
; (not mapped) raw CODE:300D   ; xchg dx, ax
raw CODE:1FD2 ; xchg cx, ax
raw CODE:1FD7 ; xchg cx, ax
; (not mapped) raw CODE:31D1   ; xchg bx, ax
; (not mapped) raw CODE:31DF   ; xchg cx, ax
; (not mapped) raw CODE:31E4   ; xchg si, ax
; (not mapped) raw CODE:3219   ; xchg bp, ax
; (not mapped) raw CODE:321B   ; xchg di, ax
; (not mapped) raw CODE:3222   ; xchg si, ax
; (not mapped) raw CODE:3223   ; xchg dx, ax
raw CODE:3774 ; xchg cx, ax
raw CODE:22F0 ; or word ptr [bp - 2], 1
raw CODE:22FB ; or word ptr [bp - 2], 2
raw CODE:2311 ; and word ptr [bp - 2], 0xffdf
raw CODE:2317 ; or word ptr [bp - 2], 0x20
raw CODE:232B ; or word ptr [bp - 2], 8
raw CODE:234B ; or word ptr [bp - 2], 2
raw CODE:2371 ; xchg dx, ax
raw CODE:23AF ; or word ptr [bp - 2], 0x10
raw CODE:23BB ; and word ptr [bp - 2], 0xffef
raw CODE:2421 ; or word ptr [bp - 2], 4
raw CODE:247D ; and word ptr [bp - 2], 0xfffb
raw CODE:25A0 ; or word ptr [bp - 2], 0x40
raw CODE:1D2E ; xchg si, ax
raw CODE:1D2F ; xchg dx, ax
