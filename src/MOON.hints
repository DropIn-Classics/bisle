; (not mapped) raw CODE:3D05   ; xchg si, ax
; (not mapped) raw CODE:3D23   ; and bx, 0xf
raw CODE:1D91 ; or di, 0xc
raw CODE:1DED ; xchg dx, ax
raw CODE:1E0D ; xchg dx, ax
raw CODE:1E2E ; xchg dx, ax
raw CODE:1E38 ; xchg bx, ax
