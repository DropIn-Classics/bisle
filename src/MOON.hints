segment T1D2C 1D2C CODE start=A prefix=T1D2C_
segment T1FF9 1FF9 CODE start=C prefix=T1FF9_
segment T2066 2066 CODE start=A prefix=T2066_
segment T2084 2084 CODE start=8 prefix=T2084_   ; T2066's last routine (fight_step) ends in its first 8 bytes (read: its two exits; not run)
segment T2250 2250 CODE start=C prefix=T2250_
segment T22D3 22D3 CODE start=2 prefix=T22D3_
segment T237F 237F CODE start=7 prefix=T237F_
segment T238E 238E CODE start=4 prefix=T238E_
