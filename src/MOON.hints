segment F2E9D 2E9D FAR_DATA prefix=F2E9D_
segment F2EAB 2EAB FAR_DATA prefix=F2EAB_
segment F2EAD 2EAD FAR_DATA prefix=F2EAD_
segment DATA  2EAE DATA
segment STACK 3021 STACK stack size=80

; the header as TLINK writes it, its relocations in its order
linker tlink 50 header=original
relocorder original

; the code generator's encodings: AND/OR with a small constant in the
; byte form and XCHG AX,reg in one byte (as TASM writes them; unlike
; BATTLE.EXE's compiler), TEST r,r as in BATTLE.EXE (not checked)
asm test_form=rm_reg

; single instructions encoded otherwise than the asm line says (build.py's
; list): AND with a small constant in the word form in CODE (compiled
; library code, presumably), ADD in the word form, and jumps at the edge
; of the short range sized otherwise than TASM's estimate
raw CODE:0783   ; and word ptr [bp + 0xa], 3
raw CODE:0DBA   ; and dx, 0
raw CODE:0DC2   ; and word ptr [bp - 4], 0x7f
raw CODE:0DC7   ; and word ptr [bp - 2], 0
raw CODE:0DE2   ; and bx, 0x7f
raw T03EB:308E   ; jmp 0x310b
raw T0F3E:0D89   ; jmp 0xe08
raw T12BF:02C0   ; add dx, 0xd
raw T2084:0807   ; jmp 0x887

; compiled switches: CMP BX,N-1 / JA default / SHL BX,1 / JMP CS:[BX+table]
; with a table of N near offsets in the code segment, found by the bytes
; of SHL BX,1 / JMP CS:[BX+d16] (D1 E3 2E FF A7) in the whole program and
; the CMP before each; the two tables carried from BATTLE.hints below
; (T2250:062B, T238E:1043) are not repeated here
words CODE:0820 12 CODE        ; from CODE:07E4 (18)
words CODE:11BE 7 CODE         ; from CODE:10EC
words CODE:2694 18 CODE        ; from CODE:22E3 (24)
words T03EB:25BE D T03EB       ; from T03EB:1054 (13)
words T0DA1:0316 7 T0DA1       ; from T0DA1:0267
words T12F0:0F51 5 T12F0       ; from T12F0:0B30
words T12F0:18A8 5 T12F0       ; from T12F0:163F
words T18B8:0A00 D T18B8       ; from T18B8:0554 (13)
words T18B8:0A1A C T18B8       ; from T18B8:025E (12)
words T18B8:0A32 9 T18B8       ; from T18B8:0087
words T18B8:1854 6 T18B8       ; from T18B8:0AE0
words T1A3E:0380 7 T1A3E       ; from T1A3E:019D
words T1A3E:06CE 8 T1A3E       ; from T1A3E:04CB
words T1A3E:08E0 6 T1A3E       ; from T1A3E:0726
words T1A3E:0A1B 5 T1A3E       ; from T1A3E:0937
words T1A3E:0D6D D T1A3E       ; from T1A3E:0A70 (13)
words T1A3E:0FA9 7 T1A3E       ; from T1A3E:0DCE
words T1A3E:127D 8 T1A3E       ; from T1A3E:0FFE
words T1A3E:1457 6 T1A3E       ; from T1A3E:133B
words T1C22:0B9D 8 T1C22       ; from T1C22:0817
words T1D2C:2C56 B T1D2C       ; from T1D2C:25F2 (11)
words T1D2C:2C6C C T1D2C       ; from T1D2C:162D (12)
words T1D2C:2C84 5 T1D2C       ; from T1D2C:12C5
words T1D2C:2C8E 6 T1D2C       ; from T1D2C:0E5A
words T1D2C:2C9A 6 T1D2C       ; from T1D2C:09B3
words T1D2C:2CA6 5 T1D2C       ; from T1D2C:05E9
words T1D2C:2CB0 5 T1D2C       ; from T1D2C:0210
words T1D2C:2CBA 4 T1D2C       ; from T1D2C:0194
words T1D2C:2CC2 D T1D2C       ; from T1D2C:00C5 (13)
words T1FF9:06CA 8 T1FF9       ; from T1FF9:00AE
words T2084:07BB 6 T2084       ; from T2084:0608
words T2084:09C3 6 T2084       ; from T2084:091E
words T2250:061D 7 T2250       ; from T2250:00C7
words T237F:00E6 7 T237F       ; from T237F:00A1

; the startup code's table of routines it calls before the program
; (CODE:01E0 with SI = 1508h, DI = 1514h; records of 6 bytes: a type, 0
; for a near routine, a priority and the pointer): two near routines,
; CODE:20F5 and CODE:2CE5 (BATTLE.EXE has three; not run)
words DATA:150A 2 CODE stride=6
; DATA:1226, 122A and 122E are far pointers to this routine, which does
; nothing (PUSH DS, DS = DATA, POP DS, RETF), as BATTLE.EXE's CODE:1D7F
code CODE:1C5D
; a far routine nothing calls (no CALL, no far pointer found by
; ptrscan.py): PUSH BP ... RETF, returns a number clamped to 0..63h (a
; percentage, presumably; not checked). BATTLE.EXE has no such bytes
code T1867:034E

; T070B fills a record's fields 4Eh..68h with far pointers to routines,
; as BATTLE.EXE's T0708:10F6 (what the record is: not checked)
ptr T070B:110E CODE   ; +4E CODE:1776
ptr T070B:111D T25AD  ; +52 T25AD:0006
ptr T070B:112C T25B6  ; +56 T25B6:0008
ptr T070B:113B T261E  ; +5A T261E:0008
ptr T070B:114A CODE   ; +5E CODE:20B0
ptr T070B:1159 T0DA1  ; +62 T0DA1:05F2
ptr T070B:1168 CODE   ; +66 CODE:1C14

; T261E:0008 (x, y, entry far, far ?, base, buffer far): a library entry
; that begins with TPWM (MOON's BIGUNIT.LIB and FIGHT.LIB pack each entry;
; tools/libfiles.py) is unpacked into the buffer by T27D5:0008 (source
; far, target far; 0 back when it was one, read from the code) and drawn
; from there with T25B6:0008, another drawn as it is (not run).
name T261E:0008 draw_packed
name T27D5:0008 unpack_mem

; ==== names of data, for the port (own lines, which the carried block below
; does not override): xfer.py maps data by the votes of matched instructions
; and these it did not.  Found by the bytes the name's place holds in
; BATTLE.EXE (initialised data: the same bytes in MOON.EXE, a hit that is
; unique or shifted as its neighbours' are) or by the matched code's
; operands; not run yet unless a note says so.
; the sound's variables: the library's code (the same as BATTLE.EXE's) has
; BATTLE.EXE's DATA offset 1AD0h + o (its ZEROS) as DATA:1514 + o here: the
; 173 matched instructions with an operand there all differ by 5BCh
name DATA:1514 op_scratch
name DATA:1530 opl_note_sel
name DATA:1531 voice_key
name DATA:153A voice_volume
name DATA:1546 voice_count
name DATA:1548 opl_port
name DATA:154A opl_wave_on
name DATA:154C voice_note
name DATA:1556 bend_range
name DATA:1558 voice_b0
name DATA:1562 voice_bend
name DATA:1574 opl_am_deep
name DATA:1575 perc_keys
name DATA:1576 opl_vib_deep
name DATA:1577 op_params
name DATA:1673 perc_mode
name DATA:1674 track_ptr
name DATA:16B4 track_time
name DATA:16F4 track_status
name DATA:1704 song_ptr
name DATA:1708 song_ended
name DATA:170A status_ptr
name DATA:170E song_volume
name DATA:1724 track_cur
name DATA:1728 song_division
name DATA:172A song_playing
; make_path's tables and the disk's marker (F27E6 of BATTLE.EXE, 0Ah further on)
name F28F9:000A name_bidisk
name F28F9:0015 disk_names
name F28F9:002D path_dirs
name F28F9:0045 path_exts
name F28F9:0081 path_made
; the menus' names and texts (F2740 of BATTLE.EXE, 4 further on)
name F2850:0004 name_menu
name F2850:000E name_codes
name F2850:0014 score_empty
name F2850:002F text_select
name F2850:0038 text_position
name F2850:0041 text_0_to_9
name F2850:004A text_please
name F2850:0051 text_insert
name F2850:0058 text_disk
name F2850:005F text_type_name
name F2850:0069 text_for_top
name F2850:0073 text_four
; the statistics' names (F27E3 of BATTLE.EXE, 6 earlier), the logo's (F2C09, 6 earlier)
name F28F7:0002 name_stats
name F28F7:0008 name_winner
name F28F7:000F name_looser
name F28F7:0016 lib_stats
name F2D2D:0006 name_bb
name F2D2D:0000 name_titel
; the messages' tables, the fight's pieces, the computer player's key tables (4, 6 and 8 further on in their own segments)
name F2825:000C fatal_messages
name F2899:000C messages
name F2E82:0006 scene_pieces
name F2E56:0008 computer_hq_order
name F2E56:000E computer_key_bits
name F2E56:0018 computer_key_sequences
; the data segment of the game's own tables (F27EE of BATTLE.EXE, EAh further on in this stretch)
name F2902:0C28 key_set_other
name F2902:0ACF around10_even
name F2902:0AE3 around10_odd
name F2902:0AF7 around4_even
name F2902:0AFF around4_odd
name F2902:0B07 lib_unit
; the map's first buffer (far pointer), as the setup in MOON.ASM stores it (F2902:0C8B, seg at 0C8D; the carry names it at BATTLE's F27EE:4152 and cursor_kept at 415A, both unmapped)
name F2902:0C8B map0
; the three tables of 1Ch-byte records that follow the cargo (T1775's make_unit and the code for factories, depots and headquarters address them so: cargo F2902:25C7 for 46h records ends at 2D6F, hqs 2 records, depots 0Ah, factories 0Ah; the carry had hqs at 0C6F and depots at 41E5, both wrong)
name F2902:2D6F hqs
name F2902:2DA7 depots
name F2902:2EBF factories
; the setup's own data in MOON.ASM (T070B): state_248e as BATTLE.EXE's, the random number routine of T0DA1 (BATTLE.EXE's T0D36:05FF), the ground parts the map uses (their count at F280C:0099, the table of far pointers to them at F2825:0050 that replaces the library's), the two buffers filled from MAPINFO.DAT and MAP02.DAT or MAP04.DAT (F280C:009B says which: 1 for the larger maps) and the names of those files
name F2902:0D43 state_248e
name T0DA1:05F2 random
; read in MOON.ASM: the C library's random seed (rand: DATA:1448, 144A), reach's kept arguments (T0C0E:0372, in the segment F2824 at 0Ah) and the cursor record kept (T0DA1:0324)
name DATA:1448 rand_seed
name F2824:000A reach_args
name F2902:4212 cursor_kept
name F280C:0099 parts_stored
name F280C:009B overview_scale
name F280C:009D overview_data
name F280C:00A1 mapinfo_data
name F280C:00CC name_mapinfo
name F280C:00D8 name_map02
name F280C:00E2 name_map04
; read in MOON.ASM (T070B:4703, T070B:49ED, the main loop's two calls after map_loop, where BATTLE.EXE calls play_anim 2 or 3, then play_anim 4 and end_credits): the films of a map won, 0Eh bytes a film (0 the headquarters taken, 1 all units gone), the ending's three names, its five lines of text at EC, 116, 13A, 15D and 177
name F280C:002D name_win_ani
name F280C:0049 name_win_pal
name F280C:0065 name_win_snd
name F280C:0081 name_end_ani
name F280C:0089 name_end_pal
name F280C:0091 name_end_snd
name F280C:00EC end_text
name T070B:4703 moon_win_film
name T070B:49ED moon_end_film
name F2825:0048 name_statmap
name F2825:0050 parts_table
; the computer player's tables as MOON's computer_start (T1867:01AE) clears them, in F2D2D: the states 0Ch bytes a player, the move records 9 bytes a unit (the attack records, named below in the carry, are at 00AC), the keys' scripts 20h a player (the carry left all three unmapped)
name F2D2D:1277 computer_state
name F2D2D:0925 computer_move_units
name F2D2D:119E computer_scripts
; the command being made follows the scripts (T1C22 addresses it at F2D2D:11DE; the carry had 1297); the module's own data, read from the DS-relative labels of MOON.ASM: the holders and the factory in F2E56 from 0027 (they run on into F2E59), the plan's values from F2E59:000C (they run on into F2E5A), the helper's unit at F2E5A:000E
name F2D2D:11DE computer_command
name F2E56:0027 computer_holder
name F2E56:002B computer_out_square
name F2E56:002D computer_repair_holder
name F2E56:0031 computer_factory
name F2E59:000C task_path_count
name F2E59:000E plan_foe
name F2E59:000F plan_unit
name F2E59:0010 plan_kind
name F2E59:0012 plan_aim
name F2E59:0014 plan_count
name F2E59:0016 plan_score
name F2E59:0018 plan_square
name F2E59:001A plan_got
name F2E59:001C plan_other
name F2E5A:000E helper_unit
; DATA: the sound's tables and the second player's counts, the picture's palette (the first two by their bytes, the others by votes of matched code)
name DATA:0DEC voice_scale
name DATA:0E77 slots
name DATA:0E89 slots_perc
name DATA:03EE input1_counts
name DATA:04A0 picture_palette
; T2695:02BB's message, pushed as 0C88h as in BATTLE.EXE (MOON.ASM)
name DATA:0C88 disk_message
; The fight scene's values (F2E5B) by hand: MOON.EXE keeps them in another
; order than BATTLE.EXE (read in T2084:0008, 0CF5 and 10B7, the counts
; and the two sides' units and shots as the port reads them; not run
; apart from the port's comparison): the counts of before and after, the
; colour bases, the frame's bits, 1 when the target does not answer, the
; numbers of shots, then the shots of the target's side (1Ch each), the
; attacker's, the units of the target's side (10h each, the first byte
; before the one that T2084:0008 clears), the attacker's
name F2E5B:005F scene_b_after
name F2E5B:0060 scene_a_after
name F2E5B:0061 scene_count_b
name F2E5B:0062 scene_count_a
name F2E5B:0063 scene_base_b
name F2E5B:0065 scene_base_a
name F2E5B:0067 scene_frame_bits
name F2E5B:0068 scene_b_silent
name F2E5B:0069 scene_shots_b_count
name F2E5B:006A scene_shots_a_count
name F2E5B:006B scene_shots_b
name F2E5B:0113 scene_shots_a
name F2E5B:01BB scene_units_b
name F2E5B:021B scene_units_a
; the units' scripts (T237F:0007 unit_script): the first, for a unit that
; is none of the others, is at 0004 here, 10 bytes before BATTLE.EXE's
name F2E8A:0000 scene_scripts
; T154F:0C9E (MOON's T1479:0C93, a type's big picture from BIGUNIT.LIB):
; the picture is placed by two tables of signed bytes, one a type (the
; type's +18h, BATTLE's y offset, is not read): x offset and y offset
name F28F3:000C bigunit_dx
name F28F3:0027 bigunit_dy
; the message box's text before load_game (the call just before T070B:1211): in the setup's
; data, not at BATTLE.EXE's F2736:0000
name F280C:000E text_insert_save

; ==== carried over from BATTLE.hints by tools/xfer.py; check, then keep or edit
; the library's assembly modules: the byte form of AND/OR, XCHG AX,reg in
; one byte, XOR r,r in the r/m,reg form (see asm above)
raw CODE:0052 ; and bx, 0xfff0
raw CODE:028F ; xor ah, ah
; (not mapped) raw CODE:300D   ; xchg dx, ax
raw CODE:1FD2 ; xchg cx, ax
raw CODE:1FD7 ; xchg cx, ax
; (not mapped) raw CODE:31D1   ; xchg bx, ax
; (not mapped) raw CODE:31DF   ; xchg cx, ax
; (not mapped) raw CODE:31E4   ; xchg si, ax
; (not mapped) raw CODE:3219   ; xchg bp, ax
; (not mapped) raw CODE:321B   ; xchg di, ax
; (not mapped) raw CODE:3222   ; xchg si, ax
; (not mapped) raw CODE:3223   ; xchg dx, ax
raw CODE:3774 ; xchg cx, ax
raw CODE:22F0 ; or word ptr [bp - 2], 1
raw CODE:22FB ; or word ptr [bp - 2], 2
raw CODE:2311 ; and word ptr [bp - 2], 0xffdf
raw CODE:2317 ; or word ptr [bp - 2], 0x20
raw CODE:232B ; or word ptr [bp - 2], 8
raw CODE:234B ; or word ptr [bp - 2], 2
raw CODE:2371 ; xchg dx, ax
raw CODE:23AF ; or word ptr [bp - 2], 0x10
raw CODE:23BB ; and word ptr [bp - 2], 0xffef
raw CODE:2421 ; or word ptr [bp - 2], 4
raw CODE:247D ; and word ptr [bp - 2], 0xfffb
