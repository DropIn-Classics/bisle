segment F280A 280A FAR_DATA prefix=F280A_
segment F280C 280C FAR_DATA prefix=F280C_
segment F2824 2824 FAR_DATA prefix=F2824_
segment F2825 2825 FAR_DATA prefix=F2825_
segment F2850 2850 FAR_DATA prefix=F2850_
segment F2899 2899 FAR_DATA prefix=F2899_
segment F28F3 28F3 FAR_DATA prefix=F28F3_
segment F28F7 28F7 FAR_DATA prefix=F28F7_
segment F28F9 28F9 FAR_DATA prefix=F28F9_
segment F2902 2902 FAR_DATA prefix=F2902_
segment F2D2D 2D2D FAR_DATA prefix=F2D2D_
segment F2E56 2E56 FAR_DATA prefix=F2E56_
segment F2E59 2E59 FAR_DATA prefix=F2E59_
segment F2E5A 2E5A FAR_DATA prefix=F2E5A_
segment F2E5B 2E5B FAR_DATA prefix=F2E5B_
segment F2E82 2E82 FAR_DATA prefix=F2E82_
segment F2E89 2E89 FAR_DATA prefix=F2E89_
