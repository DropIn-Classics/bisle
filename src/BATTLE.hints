; BATTLE.EXE: the game (Battle Isle), Borland C++ 1991, large model;
; started by BI.EXE after the intro.
; Hints for doskit/tools/disasm.py; numbers are hex.

exe ISLE/BATTLE.EXE

; the segments, from the relocations and the header (SS:SP = 2F32:0080);
; DS holds DGROUP (DATA, 2D8D: the startup code loads it). A module's code
; segment T.... begins where the one before ends (start=, first guessed
; from the lowest offset a far CALL/JMP enters it by)
segment CODE  0000 CODE
segment T0408 0408 CODE start=B prefix=T0408_
segment T0708 0708 CODE start=E prefix=T0708_
segment T0B70 0B70 CODE start=E prefix=T0B70_
segment T0BA0 0BA0 CODE start=3 prefix=T0BA0_
segment T0CEB 0CEB CODE start=8 prefix=T0CEB_
segment T0D36 0D36 CODE start=F prefix=T0D36_
segment T0E9B 0E9B CODE start=B prefix=T0E9B_
segment T1090 1090 CODE start=E prefix=T1090_
segment T11FD 11FD CODE start=4 prefix=T11FD_
segment T122D 122D CODE start=2 prefix=T122D_
segment T13CA 13CA CODE start=F prefix=T13CA_
segment T1479 1479 CODE start=4 prefix=T1479_
segment T15AC 15AC CODE start=7 prefix=T15AC_
segment T164D 164D CODE start=C prefix=T164D_
segment T169E 169E CODE start=E prefix=T169E_
segment T1727 1727 CODE start=4 prefix=T1727_
segment T178C 178C CODE start=D prefix=T178C_
