segment T1F5A 1F5A CODE start=1 prefix=T1F5A_   ; T1F3C's last routine ends in its first byte (a RETF; a run)
segment T2112 2112 CODE start=B prefix=T2112_
segment T2190 2190 CODE start=D prefix=T2190_
segment T223C 223C CODE start=1 prefix=T223C_
segment T2248 2248 CODE start=4 prefix=T2248_
