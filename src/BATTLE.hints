segment T24A8 24A8 CODE start=8 prefix=T24A8_
segment T24B5 24B5 CODE start=E prefix=T24B5_
segment T24BA 24BA CODE start=8 prefix=T24BA_
segment T24C5 24C5 CODE prefix=T24C5_
segment T24D2 24D2 CODE prefix=T24D2_
segment T24D3 24D3 CODE prefix=T24D3_
segment T24D8 24D8 CODE start=8 prefix=T24D8_
segment T24DF 24DF CODE start=2 prefix=T24DF_
segment T2503 2503 CODE start=6 prefix=T2503_
segment T2506 2506 CODE start=A prefix=T2506_
segment T2515 2515 CODE start=8 prefix=T2515_
segment T251F 251F CODE start=E prefix=T251F_
segment T2525 2525 CODE start=A prefix=T2525_
segment T2536 2536 CODE start=4 prefix=T2536_
segment T253B 253B CODE start=2 prefix=T253B_
segment T253C 253C CODE start=E prefix=T253C_
segment T253E 253E CODE start=A prefix=T253E_
segment T2541 2541 CODE start=4 prefix=T2541_
segment T2550 2550 CODE start=6 prefix=T2550_
segment T258F 258F CODE start=2 prefix=T258F_
segment T2590 2590 CODE start=A prefix=T2590_
segment T2592 2592 CODE start=2 prefix=T2592_
