; BI.EXE: the launcher of Battle Isle (ISLE/). Checks the BIDISK.* marker
; files, runs INTVGA\INTRO.EXE or INTEGA\INTRO.EXE and then BATTLE.EXE
; (read from the code and seen in runs; see check_card below).
; Hints for doskit/tools/disasm.py; numbers are hex.

exe ISLE/BI.EXE

; the segments, from the relocations and the header (SS:SP = 0245:0100);
; the names other than CODE, DATA and STACK say their frame. The original's
; segments are WORD or BYTE aligned: each begins where the one before ends
; (start=), here at the lowest offset a far CALL/JMP enters it (S0022: after
; CODE's last RETF), read from the bytes, not from a map
segment CODE  0000 CODE
segment S0022 0022 CODE prefix=S22_ start=3
segment S0093 0093 CODE prefix=S93_ start=C
segment S0095 0095 CODE prefix=S95_ start=C
segment S00B4 00B4 CODE prefix=SB4_ start=C
segment S00EA 00EA CODE prefix=SEA_ start=8
segment S00EC 00EC CODE prefix=SEC_ start=8
segment S00F2 00F2 CODE prefix=SF2_
segment S00FC 00FC CODE prefix=SFC_ start=6
segment S00FE 00FE CODE prefix=SFE_ start=2
segment S00FF 00FF CODE prefix=SFF_ start=A
segment S0102 0102 CODE prefix=S102_ start=A
segment S0107 0107 CODE prefix=S107_ start=E
segment S012B 012B CODE prefix=S12B_ start=A
segment S0131 0131 CODE prefix=S131_ start=C
segment S0143 0143 CODE prefix=S143_ start=8
segment S014F 014F CODE prefix=S14F_ start=C
segment S015B 015B CODE prefix=S15B_ start=8
segment DATA  015D DATA
segment STACK 0245 STACK stack size=100

; the header as TLINK writes it (its mark at 1Ch), the relocations in its
; order (that of the object records, not rebuilt)
linker tlink 30
relocorder original

; which intro: check_card sets DATA:0004 to 0 for VGA, 1 for EGA, in this
; order: /V or /v in the command tail (AX=562Fh: '/', then 'V', found by
; find_switch, which retries with the letter in lower case) gives VGA, /E
; or /e EGA; else the marker file BIDISK.EGA opens (DATA:003C) gives EGA,
; else BIDISK.VGA (DATA:0031) VGA, else INT 10h AX=1A00h (the display
; combination) answering AL=1Ah VGA, else EGA. VGA changes to INTVGA (the
; 16-colour intro, mode 0Dh), EGA to INTEGA (the 256-colour one, 13h), and
; runs INTRO.EXE there with BI.EXE's own command tail (the EXEC block at
; DATA:0008 points to PSP:0080). Then CD .. and BIDISK.VGA or .EGA by the
; same choice must open before BATTLE.EXE runs, with the same tail; if not,
; "PLEASE INSERT DISC <VGA>/<EGA>", a key, and again, up to three times
; (DATA:0006 counts), then "PROGRAM NOT FOUND" (DATA:0084) and the end.
; GOG's folder has all three marker files and starts `bi.exe` without
; arguments, so it runs INTEGA's intro: seen in runs (no arguments: opens
; BIDISK.EGA, CD INTEGA; /v: CD INTVGA; /e: CD INTEGA; after the intro's
; exit at 200 s: CD .., BIDISK.EGA, BATTLE.EXE). BIDISK.INT (DATA:0047)
; is not opened here: no instruction takes its offset as read.
name CODE:01BA check_card
name CODE:0196 find_switch
name CODE:0104 error_exit       ; shows the message AX, waits for a key
name CODE:014D ask_disk         ; the same at another place, returns
name DATA:0004 is_ega
name DATA:0006 disk_tries

; S0107's code addresses CS:0240, the first byte after its own end (the
; first of S012B's): kept a number
num S0107:01D5
num S0107:021C
num S0107:0232

; S0022 is called by nothing: no relocation outside it names its segment
; and no far pointer leads into it. It is a library module linked in and
; not used (presumably); the same timer and keyboard module as T2354 in
; BATTLE.EXE, by its first routine (not compared in full). Written as
; code so that it reads: its routines, each after a RETF, entered here;
; the segments only S0022 calls (S0093, S0095, S00B4, S00EA, S00EC,
; S00F2, S00FC, S00FE, S0131, S0143, S014F) follow from them
code S0022:0011         ; sets a timer callback and INT 24h
code S0022:005E
code S0022:03E4         ; sets INT 09h
code S0022:0423
code S0022:0465         ; OUT 43h,36h: sets the timer chip's channel 0
code S0022:060B
code S0022:06A5
code S0022:06E9
code S0022:06FE
code S0022:070A
; the handlers it sets
ptr S0022:0021 S0022    ; mov ax,008Ah / mov dx,S0022: the timer callback,
                        ; period 4000h (call S0022:05A6)
ptr S0022:0048 S0022    ; INT 21h AH=25h AL=24h, DS = CS, DX = 03D4h
ptr S0022:0412 S0022    ; INT 21h AH=25h AL=09h, DS = CS, DX = 0378h
ptr S0022:0485 S0022    ; mov ax,04F0h: slot 0, calls the INT 08h handler
                        ; that was there before (as T2354:063C in BATTLE)
ptr S0022:04E6 S0022    ; INT 21h AX=2508h, DS = S0022, DX = 0516h
