raw T0608:000F ; or word ptr [0x368], 0
raw T060D:0171 ; or dx, 0
raw T060D:02E3 ; or word ptr [0x368], 0
; (not mapped) raw T26D2:0035   ; and cx, 0xf
; (not mapped) raw T26DE:0017   ; and cx, 0xf
